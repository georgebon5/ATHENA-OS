{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "events.json",
  "definitions": {
    "DemoBeat": {
      "title": "DemoBeat",
      "type": "string",
      "enum": [
        "INTRO",
        "PITCH",
        "SENSE",
        "SIMULATE",
        "ENGAGE",
        "DECISION",
        "CLOSE"
      ]
    },
    "LayerKey": {
      "title": "LayerKey",
      "type": "string",
      "enum": [
        "traffic",
        "thermal",
        "reports",
        "votes",
        "buses"
      ]
    },
    "AgentMood": {
      "title": "AgentMood",
      "type": "string",
      "enum": [
        "neutral",
        "alert",
        "proud"
      ]
    },
    "BusesUpdatePayload": {
      "title": "BusesUpdatePayload",
      "type": "object",
      "required": [
        "buses"
      ],
      "properties": {
        "buses": {
          "type": "array",
          "items": {
            "$ref": "city.json#/definitions/Bus"
          }
        }
      }
    },
    "ReportHiddenPayload": {
      "title": "ReportHiddenPayload",
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "description": "ΠΡΟΤΑΣΗ Dev4: ο director κρύβει ακατάλληλη φωτογραφία (moderation)"
    },
    "AgentSayPayload": {
      "title": "AgentSayPayload",
      "type": "object",
      "required": [
        "textEl"
      ],
      "properties": {
        "textEl": {
          "type": "string"
        },
        "audioUrl": {
          "type": "string"
        },
        "mood": {
          "$ref": "events.json#/definitions/AgentMood"
        }
      }
    },
    "AgentThinkingPayload": {
      "title": "AgentThinkingPayload",
      "type": "object",
      "required": [
        "stepEl"
      ],
      "properties": {
        "stepEl": {
          "type": "string"
        }
      }
    },
    "CameraFlyToPayload": {
      "title": "CameraFlyToPayload",
      "type": "object",
      "required": [
        "lngLat",
        "heightM",
        "headingDeg",
        "pitchDeg",
        "durationS"
      ],
      "properties": {
        "lngLat": {
          "$ref": "geo.json#/definitions/LngLat"
        },
        "heightM": {
          "type": "number"
        },
        "headingDeg": {
          "type": "number"
        },
        "pitchDeg": {
          "type": "number"
        },
        "durationS": {
          "type": "number",
          "minimum": 0
        },
        "shot": {
          "type": "string",
          "description": "Όνομα προκαθορισμένου πλάνου του web (π.χ. orbitSerafio)"
        }
      }
    },
    "LayerSetPayload": {
      "title": "LayerSetPayload",
      "type": "object",
      "required": [
        "layer",
        "visible"
      ],
      "properties": {
        "layer": {
          "$ref": "events.json#/definitions/LayerKey"
        },
        "visible": {
          "type": "boolean"
        }
      }
    },
    "TimeSetPayload": {
      "title": "TimeSetPayload",
      "type": "object",
      "required": [
        "when"
      ],
      "properties": {
        "when": {
          "type": "string",
          "description": "ISO 8601"
        }
      }
    },
    "SimProgressPayload": {
      "title": "SimProgressPayload",
      "type": "object",
      "required": [
        "scenarioId",
        "pct"
      ],
      "properties": {
        "scenarioId": {
          "type": "string"
        },
        "pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Κλάσμα 0–1"
        }
      }
    },
    "VariantComparePayload": {
      "title": "VariantComparePayload",
      "type": "object",
      "required": [
        "base",
        "best",
        "reasonEl"
      ],
      "properties": {
        "base": {
          "$ref": "sim.json#/definitions/SimResult"
        },
        "best": {
          "$ref": "sim.json#/definitions/SimResult"
        },
        "reasonEl": {
          "type": "string"
        }
      }
    },
    "BacktestShowPayload": {
      "title": "BacktestShowPayload",
      "type": "object",
      "required": [
        "model"
      ],
      "properties": {
        "model": {
          "type": "string",
          "enum": [
            "traffic",
            "thermal"
          ]
        }
      }
    },
    "DirectorBeatPayload": {
      "title": "DirectorBeatPayload",
      "type": "object",
      "required": [
        "beat"
      ],
      "properties": {
        "beat": {
          "$ref": "events.json#/definitions/DemoBeat"
        }
      }
    },
    "ServiceState": {
      "title": "ServiceState",
      "type": "string",
      "enum": [
        "up",
        "down",
        "mock"
      ]
    },
    "SystemStatus": {
      "title": "SystemStatus",
      "type": "object",
      "required": [
        "at",
        "services",
        "fallbacks"
      ],
      "properties": {
        "at": {
          "type": "string"
        },
        "services": {
          "title": "SystemServices",
          "type": "object",
          "required": [
            "db",
            "sim",
            "agent",
            "oasa"
          ],
          "properties": {
            "db": {
              "type": "string",
              "enum": [
                "postgres",
                "sqlite"
              ]
            },
            "sim": {
              "$ref": "events.json#/definitions/ServiceState"
            },
            "agent": {
              "$ref": "events.json#/definitions/ServiceState"
            },
            "oasa": {
              "$ref": "city.json#/definitions/DataSource"
            }
          }
        },
        "fallbacks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Πρόσφατα fallbacks, στα ελληνικά. Δείχνονται ΜΟΝΟ στον director."
        }
      },
      "description": "ΠΡΟΤΑΣΗ Dev4: κατάσταση υπηρεσιών. Το web το δείχνει μόνο στο director panel, ποτέ στο κοινό."
    },
    "StateResetPayload": {
      "title": "StateResetPayload",
      "type": "object",
      "required": [],
      "properties": {},
      "description": "ΠΡΟΤΑΣΗ Dev4: ο director έκανε reset για νέα πρόβα. Ο client καθαρίζει σενάριο/ψήφους/απόφαση."
    },
    "BusesUpdateEvent": {
      "title": "BusesUpdateEvent",
      "type": "object",
      "required": [
        "type",
        "payload"
      ],
      "properties": {
        "type": {
          "const": "buses.update"
        },
        "payload": {
          "$ref": "events.json#/definitions/BusesUpdatePayload"
        },
        "replay": {
          "type": "boolean",
          "description": "true όταν ο gateway ξαναστέλνει την κατάσταση σε νέο client (χωρίς animation/ήχο)"
        }
      }
    },
    "ReportCreatedEvent": {
      "title": "ReportCreatedEvent",
