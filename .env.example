# Αντέγραψε σε .env και συμπλήρωσε. ΠΟΤΕ μην κάνεις commit το .env.

# 1 = όλες οι υπηρεσίες απαντούν από τα fixtures (packages/contracts/fixtures)
MOCK=0

# --- Gateway (Dev4) ---
GATEWAY_URL=http://localhost:8000
# Δημόσιο URL του citizen app (tunnel). Το QR δείχνει στο {PUBLIC_CITIZEN_URL}/v/{id}
PUBLIC_CITIZEN_URL=https://<tunnel-or-vercel>/c
# Αν η Postgres δεν απαντά στο startup, ο gateway πέφτει αυτόματα σε SQLite
DATABASE_URL=postgresql://athena:athena@localhost:5432/athena
# Host ports του docker compose (άλλαξέ τα αν είναι πιασμένα, π.χ. από τοπική Postgres)
POSTGRES_PORT=5432
GATEWAY_PORT=8000
# Σε ποιο interface ακούει ο gateway στο docker (127.0.0.1 = μόνο τοπικά)
GATEWAY_BIND=0.0.0.0

# --- Εσωτερικές υπηρεσίες ---
SIM_URL=http://localhost:8100
AGENT_URL=http://localhost:8200

# --- AI (Dev3) ---
LLM_API_KEY=
STT_API_KEY=
TTS_API_KEY=
IMAGE_EDIT_API_KEY=

# --- 3D (Dev1) ---
CESIUM_ION_TOKEN=
# Photorealistic 3D Tiles
GOOGLE_MAPS_API_KEY=
# AthensGov Sandbox: GET /v1/projects.geojson → δημοτικά έργα στον χάρτη. Χωρίς key → fixture.
VITE_ATHENSGOV_API_KEY=

# --- ΟΑΣΑ ---
# Το http:// κάνει timeout· μόνο το https:// απαντά (έλεγχος 18/11/2026)
OASA_BASE_URL=https://telematics.oasa.gr/api/
# live | replay | mock. Στο live, αν το API πέσει, γυρίζει μόνο του σε replay.
OASA_MODE=live
# 1 = σώζει κάθε poll στο demo/cache/oasa/ για replay
OASA_RECORD=0

# --- Tunnel (Cloudflare named tunnel για σταθερό domain στο demo) ---
CLOUDFLARE_TUNNEL_TOKEN=
