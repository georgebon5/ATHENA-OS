{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "internal.json",
  "definitions": {
    "NearbyReport": {
      "title": "NearbyReport",
      "type": "object",
      "required": ["id", "distanceM"],
      "properties": {
        "id": { "type": "string" },
        "distanceM": { "type": "number" },
        "category": { "$ref": "report.json#/definitions/ReportCategory" }
      }
    },
    "ClassifyRequest": {
      "title": "ClassifyRequest",
      "description": "gateway → agent: POST {AGENT_URL}/classify. Απάντηση: ReportClassification.",
      "type": "object",
      "required": ["report", "imageBase64", "mimeType", "nearby"],
      "properties": {
        "report": { "$ref": "report.json#/definitions/Report" },
        "imageBase64": { "type": "string", "description": "Η φωτογραφία (ήδη resized ~1600px)" },
        "mimeType": { "type": "string" },
        "nearby": {
          "description": "Αναφορές σε ακτίνα 50 m (PostGIS), για να γεμίσει το duplicates",
          "type": "array",
          "items": { "$ref": "internal.json#/definitions/NearbyReport" }
        }
      }
    },
    "AgentPrompt": {
      "title": "AgentPrompt",
      "description": "web → gateway POST /api/agent/prompt → agent POST {AGENT_URL}/prompt",
      "type": "object",
      "required": ["textEl"],
      "properties": {
        "textEl": { "type": "string" }
      }
    },
    "MediaUploadResult": {
      "title": "MediaUploadResult",
      "description": "Απάντηση του POST /api/media (εικόνες after, audio του TTS)",
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": { "type": "string" }
      }
    }
  }
}
