# URL του gateway (REST + WS). Στο dev αφήνουμε κενό για localhost:8000
VITE_GATEWAY_URL=
# Override του WS endpoint — χρήσιμο όταν τρέχει το mock-ws script (ws://localhost:8787)
VITE_WS_URL=
VITE_GATEWAY_PORT=8000
# Cesium Ion token (OSM Buildings + terrain). Προαιρετικό στο dev.
VITE_CESIUM_ION_TOKEN=
# Google Maps API key για Photorealistic 3D Tiles. Αν λείπει πέφτει σε OSM Buildings.
VITE_GOOGLE_MAPS_API_KEY=
